# Disable directory browsing
Options -Indexes

# Enable the rewrite engine
<IfModule mod_rewrite.c>
    Options +FollowSymLinks
    RewriteEngine On
    
    # Set the base URL - adjust this path if your application is in a subdirectory
    RewriteBase /GOMEZ/public/
    
    # Redirect to remove index.php from the URL
    RewriteCond %{THE_REQUEST} ^GET.*index\.php [NC]
    RewriteRule (.*?)index\.php/*(.*) /GOMEZ/$1$2 [R=301,NE,L]
    
    # If the requested file or directory doesn't exist
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Redirect all requests to index.php
    RewriteRule ^(.*)$ index.php?/$1 [L]
    
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Prevent direct access to sensitive files
<FilesMatch "\.(env|json|config\.php|database\.php|routes\.php|spark)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# If mod_rewrite is not enabled
<IfModule !mod_rewrite.c>
    ErrorDocument 404 index.php
</IfModule>

# Disable server signature
ServerSignature Off
